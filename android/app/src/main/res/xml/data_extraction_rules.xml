<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/传输规则，语义与 backup_rules.xml 相同，见那边的注释。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="inputa_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="inputa_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
