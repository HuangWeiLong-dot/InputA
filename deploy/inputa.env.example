# /etc/inputa.env —— systemd 读的环境变量。权限 600，**不属于仓库**。
#
# setup-server.sh 会在文件不存在时用这份模板生成它，之后不再覆盖（里面是真实配置）。

# 后端监听端口。Caddy 反代到这个端口，8787 本身不对外开放。
API_PORT=8787

# 放行哪些浏览器来源。GitHub Pages 的前端和 API 不同源，不写在这里的话浏览器会
# 拦掉每一个 /api 响应（响应缺少 Access-Control-Allow-Origin）。
# 逗号分隔多个；localhost / 127.0.0.1 无需列出，永远放行。
CORS_ALLOWED_ORIGINS=https://huangweilong-dot.github.io

# 离线词典路径。**必须是绝对路径** —— STARDICT_DB 是相对进程工作目录解析的。
# 不设的话默认是 <应用目录>/data/stardict.db。
STARDICT_DB=/opt/inputa/app/data/stardict.db

# ⚠️ 除非你给 /api/ai/chat 加了鉴权，否则不要打开这一行。
#
# 后端一旦持有 key 就会优先用它，而那个接口没有任何鉴权、公网可达 —— 等于把你的
# DeepSeek 额度公开给任何人刷。默认让读者在浏览器里填自己的 key（请求会带着它转发
# 到上游），费用就落在使用者头上。
#
#DEEPSEEK_API_KEY=sk-...
