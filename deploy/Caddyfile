# Caddy 站在 127.0.0.1:8787 前面，负责 TLS。证书由 Let's Encrypt 自动签发并续期。
#
# 走 HTTP-01 挑战就够了 —— DuckDNS 的子域名有公网 A 记录，Let's Encrypt 能直接
# 访问到这台机器，所以不需要 DNS 插件，也不需要自己用 xcaddy 重新编译 Caddy。
# 前提是腾讯云安全组放行 80（挑战）和 443（对外服务）。
#
# setup-server.sh 会把下面这个占位符替换成你实际的 DuckDNS 子域名。手工部署时自己
# 改这一行即可（只换除 .duckdns.org 之外的那一段）。
REPLACE_WITH_YOUR_DUCKDNS_HOST {
	reverse_proxy 127.0.0.1:8787

	# Gutenberg 的纯文本正文最大 12MB（server/upstreams.js 的上限），而且是
	# text/plain —— 压缩它收益很大，而 Node 自己不压缩。
	encode gzip

	# 请求体上限。后端自己的上限是 1MB（server/index.js 的 MAX_BODY_BYTES），
	# 这里留出余量，好让超限时是后端那条 JSON 错误先说话，而不是 Caddy 的。
	request_body {
		max_size 2MB
	}
}
